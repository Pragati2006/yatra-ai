# ==============================================================================
# YATRA AI -- PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env.production' on your local deployment machine.
# Fill in your actual values. NEVER commit '.env.production' or expose your secrets.
# ==============================================================================

# 1. Environment & Security Mode
APP_ENV=production
ENV=production
ENABLE_DEV_TEST_ENDPOINTS=false

# 2. Local Storage & Database Directory
# Resolves the directory where SQLite databases (sessions.db, auth_store.db) and curated files live.
# Default: ./data (relative to project root)
DATA_DIR=./data
AUTH_DB_PATH=./data/auth_store.db
SESSIONS_DB_PATH=./data/sessions.db

# 3. Cryptographic Authentication Signing Secret (MANDATORY)
# In production, Yatra AI rejects default, predictable, or missing secrets.
# Generate a cryptographically random 256-bit hex secret in PowerShell:
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Or in Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_HMAC_SECRET=your_cryptographically_secure_256_bit_hex_secret_here

# 4. CORS Allowed Origins (Comma-separated)
# Explicit list of trusted frontend origins permitted to access this backend in production.
# In production mode, wildcard '*' is strictly rejected because allow_credentials=True requires explicit origins.
# Set this ONLY to your actual public production frontend origin(s).
# Do NOT include localhost origins in production unless performing local-only preview evaluation.
# Example for Cloudflare Pages: https://<your-project>.pages.dev
# Example with custom domain: https://yatra-ai.pages.dev,https://yatra.yourdomain.org
CORS_ALLOWED_ORIGINS=https://yatra-ai.pages.dev

# 5. Cookie Security
# Set to true when frontend and backend communicate over HTTPS
COOKIE_SECURE=true

# 6. LLM Inference API Key (Groq Cloud)
# Required for central conversational multi-turn planner.
# If omitted or unconfigured, the system automatically falls back to deterministic rule-based orchestration.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 7. Curated Tourism Database (MongoDB Atlas) [OPTIONAL]
# If omitted or connection times out, Yatra AI's internal circuit breaker automatically falls back
# to local curated JSON datasets without throwing unhandled exceptions.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tourism_db?retryWrites=true&w=majority
MONGODB_DB_NAME=tourism_db

# 8. Email Delivery / SMTP Policy Notice
# Under the academic student constraints (₹0 spending, no paid SMTP services), email OTP delivery
# is intentionally unconfigured. The entire application (itinerary planning, transport guidance,
# elevation weather, accommodation discovery, and mock booking simulation) remains 100% accessible
# to devotees in Guest Mode without requiring email delivery.
