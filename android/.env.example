# Yatra AI Android Client (React Native + Expo) - Environment Variables
# Default Production Render Backend (for Standalone APK / Release builds):
EXPO_PUBLIC_API_URL=https://yatra-ai-smap.onrender.com

# For local development with Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# For physical devices on local Wi-Fi or Cloudflare Quick Tunnel:
# EXPO_PUBLIC_API_URL=https://your-quick-tunnel-subdomain.trycloudflare.com
