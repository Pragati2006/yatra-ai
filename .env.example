# ==============================================================================
# Environment Configuration Template for Yatra AI
# Copy this file to '.env' and populate with your own credentials.
# Do NOT commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Centralized Paths
# ------------------------------------------------------------------------------
APP_ENV=development
DATA_DIR=data
ENABLE_DEV_TEST_ENDPOINTS=true

# ------------------------------------------------------------------------------
# 2. Groq Cloud API Key (Required for Primary ChatGroq AI Tourism Assistant)
# Obtain your free API key at: https://console.groq.com/keys
# Preferred models: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. MongoDB Atlas Database Configuration (Optional)
# If unconfigured or unreachable, the system automatically engages an internal
# circuit breaker and uses local curated CSV datasets in `data/`.
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=yatra_ai

# ------------------------------------------------------------------------------
# 4. SMTP Email Configuration for Passwordless Authentication (Optional)
# If omitted or unconfigured, the application falls back to MockEmailProvider,
# outputting OTPs to backend logs and the live dev endpoint (/api/auth/test/latest-otp).
# ------------------------------------------------------------------------------
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_email_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@yatra-ai.org

# ------------------------------------------------------------------------------
# 5. Optional: OpenAI-compatible LLM Configuration (Secondary Fallback)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
