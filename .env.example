# ==============================================================================
# Environment Configuration Template for Yatra AI
# Copy this file to '.env' and populate with your own credentials.
# Do NOT commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Deployment Configuration
# ------------------------------------------------------------------------------
# Set to 'production' on live hosts (Render, Fly.io, VPS) or 'development' locally.
APP_ENV=development
PORT=8000

# Persistent storage mount directory for SQLite databases (sessions.db & auth_store.db).
# On PaaS with persistent volume mounts, set to the mounted volume path (e.g., /data or /mnt/data).
DATA_DIR=data

# Optional explicit database paths (default to DATA_DIR/auth_store.db and DATA_DIR/sessions.db)
# AUTH_DB_PATH=data/auth_store.db
# SESSIONS_DB_PATH=data/sessions.db

# Controls development inspection endpoints (e.g., /api/auth/test/latest-otp).
# Automatically blocked whenever APP_ENV=production.
ENABLE_DEV_TEST_ENDPOINTS=true

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins (Critical for Remote Frontend Connectivity)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend web origins.
# In development (APP_ENV=development), localhost origins are automatically included.
# In production (APP_ENV=production), strictly only origins listed here are accepted.
# Wildcard '*' is strictly prohibited when allow_credentials=True.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yatra-ai.vercel.app

# ------------------------------------------------------------------------------
# 3. Server Authentication Secret (Mandatory in Production)
# ------------------------------------------------------------------------------
# High-entropy secret used for HMAC-SHA256 OTP hashing and session signature.
# In production (APP_ENV=production), this must be explicitly set and at least 32 chars.
# In development, falls back to internal development default salt.
AUTH_HMAC_SECRET=replace_with_high_entropy_secret_minimum_32_characters_long

# Set to true when serving over HTTPS to enforce Secure cookie flags.
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. Groq Cloud API Key (Mandatory for Central Conversational AI Agent)
# ------------------------------------------------------------------------------
# Obtain your free API key at: https://console.groq.com/keys
# Preferred models: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# 5. SMTP Email Configuration for Live Email OTP Delivery
# ------------------------------------------------------------------------------
# In production, SMTP configuration is required for OTP email delivery.
# If omitted or unconfigured in production, OTP dispatch returns a 503 error.
# In development mode, falls back to safe local MockEmailProvider.
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_or_api_key
SMTP_PASSWORD=your_smtp_password_or_token
SMTP_FROM_EMAIL=noreply@yatra-ai.org

# ------------------------------------------------------------------------------
# 6. MongoDB Atlas Database Configuration (Optional Cloud Knowledge Base)
# ------------------------------------------------------------------------------
# If unconfigured or unreachable, the system automatically engages an internal
# circuit breaker and uses local curated JSON/CSV datasets in `data/`.
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=yatra_ai

# ------------------------------------------------------------------------------
# Production Startup Command Reference
# ------------------------------------------------------------------------------
# For production PaaS / Docker containers:
# uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips='*'
